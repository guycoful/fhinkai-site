# Force HTTPS - all HTTP requests redirected to HTTPS with 301 permanent redirect
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]
RewriteRule ^(landing|READY)/?$ - [E=FHINK_FLOW_HTML:1]
RewriteRule ^(landing|READY)/index\.html$ - [E=FHINK_FLOW_HTML:1]
RewriteRule ^(landing|READY)/script\.js$ - [E=FHINK_FLOW_JS:1]

# Security headers
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # JetServer LiteSpeed defaults to 30-day cache on static files. On 18.5.2026
    # a script.js fix went live but browsers kept serving the cached 404 version
    # for the entire pilot window. Override with short cache windows so future
    # fixes propagate within minutes.
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=600, must-revalidate"
    </FilesMatch>

    # The landing flow broke when browsers kept a stale /landing/script.js that
    # still redirected to /questionnaire for up to 30 days. Keep the general
    # short cache windows above, but fully disable browser reuse on the
    # conversion-critical HTML and JS entrypoints.
    Header always unset Cache-Control env=FHINK_FLOW_HTML
    Header always unset Cache-Control env=FHINK_FLOW_JS
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=FHINK_FLOW_HTML
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=FHINK_FLOW_JS
    Header always set Pragma "no-cache" env=FHINK_FLOW_HTML
    Header always set Pragma "no-cache" env=FHINK_FLOW_JS
    Header always set Expires "0" env=FHINK_FLOW_HTML
    Header always set Expires "0" env=FHINK_FLOW_JS
</IfModule>
