# Force HTTPS - all HTTP requests redirected to HTTPS with 301 permanent redirect
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

# 18.5.2026 emergency: /landing/ has a broken script.js cached for 30 days in
# every visitor's browser. Move pilot traffic to /start/ which no browser has
# in cache, redirect /landing/ permanently so any new request that still hits
# /landing/ ends up at the working page.
RewriteRule ^landing/?$ /start/ [L,R=301]
RewriteRule ^landing/(.*)$ /start/$1 [L,R=301]

# Security headers
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # JetServer LiteSpeed defaults to 30-day cache on static files. On 18.5.2026
    # a script.js fix went live but browsers kept serving the cached 404 version
    # for the entire pilot window. Override with short cache windows so future
    # fixes propagate within minutes.
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=600, must-revalidate"
    </FilesMatch>
</IfModule>
